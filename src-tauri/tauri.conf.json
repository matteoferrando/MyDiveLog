{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyDiveLog",
  "version": "1.4.0",
  "identifier": "it.ferrando.mydivelog",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MyDiveLog",
        "width": 1180,
        "height": 820,
        "minWidth": 720,
        "minHeight": 560,
        "titleBarStyle": "Transparent",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost https://*.turso.io https://api.anthropic.com https://mydivelog-accesso.mydivelog.workers.dev"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "© Matteo Ferrando",
    "category": "Utility",
    "createUpdaterArtifacts": true,
    "shortDescription": "Il meglio dei tuoi computer, in un logbook solo",
    "longDescription": "Logbook delle immersioni che unisce i dati di più computer subacquei prendendo da ognuno quello che registra meglio, e ne ricava statistiche, suggerimenti e pianificazione del gas sul consumo misurato.",
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "iOS": {
      "minimumSystemVersion": "15.0",
      "developmentTeam": "73F4VR2CMU",
      "frameworks": ["CoreBluetooth"]
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/matteoferrando/MyDiveLog/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc2M0VDMjI4RjI1QTEyMjQKUldRa0VscnlLTUkrZGxYMjNmVnFIbFFQbWgzeGRFd25xbWE2cjQwSXUyL3M3KzE1VWJIa3NzTDAK"
    }
  }
}
