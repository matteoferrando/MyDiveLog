{
  "name": "mydivelog",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Logbook subacqueo multi-computer con statistiche e piani di miglioramento",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:tz": "TZ=Pacific/Kiritimati vitest run && TZ=Pacific/Midway vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "desktop:build": "tauri build",
    "ios:init": "tauri ios init",
    "ios:dev": "tauri ios dev",
    "demo": "tsx scripts/generate-demo-data.ts",
    "screenshot": "node scripts/screenshot.mjs",
    "validate:logtrak": "tsx scripts/validate-logtrak.ts",
    "validate:pnf": "tsx scripts/validate-pnf.ts",
    "validate:gf": "tsx scripts/validate-gf.ts"
  },
  "dependencies": {
    "@garmin/fitsdk": "^21.171.0",
    "@libsql/client": "^0.17.4",
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-sql": "^2.3.0",
    "fast-xml-parser": "^5.2.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tauri-apps/cli": "^2.9.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
